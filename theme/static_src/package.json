{
  "name": "theme",
  "version": "3.8.0",
  "description": "",
  "scripts": {
    "start": "npm run dev",
    "build": "npm run build:clean && npm run build:tailwind && npm run build:vendor",
    "build:clean": "rimraf ../static/css/dist",
    "build:tailwind": "cross-env NODE_ENV=production tailwindcss --postcss -i ./src/styles.css -o ../static/css/dist/styles.css --minify",
    "build:vendor": "cp node_modules/alpinejs/dist/cdn.min.js ../../static/js/alpine.min.js",
    "dev": "cross-env NODE_ENV=development tailwindcss --postcss -i ./src/styles.css -o ../static/css/dist/styles.css -w",
    "tailwindcss": "node ./node_modules/tailwindcss/lib/cli.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "alpinejs": "^3.16.3",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.26",
    "postcss-import": "^17.0.0",
    "postcss-nested": "^8.0.1",
    "postcss-simple-vars": "^7.0.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.19"
  },
  "engines": {
    "node": ">=22"
  }
}
