# Graffiti House development environment
# Copy this file to .env and replace placeholder values as needed.

# Django
DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1:8000
DJANGO_READ_DOT_ENV_FILE=True

# Email. Login codes and password resets are sent through this backend.
# Default prints messages to the terminal. Production example:
# EMAIL_URL=smtp+tls://user:password@smtp.example.org:587
EMAIL_URL=
DEFAULT_FROM_EMAIL=graffitihouse@localhost

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=graffitihouse
DB_USER=graffitihouse
DB_PASS=password
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECK=True
DB_APPLICATION_NAME=graffitihouse-local
DB_SSLMODE=
DB_SSLROOTCERT=

# Optional: override the individual database settings above. Passwords and
# other URL components containing reserved characters must be percent-encoded.
# Examples:
# DATABASE_URL=sqlite:///:memory:
# DATABASE_URL=postgresql://readonly_user:encoded-password@db.example.org:5432/graffitihouse?sslmode=require
DATABASE_URL=

# Ask PostgreSQL to reject writes made through this connection. Enable this
# when inspecting a shared or production database from a local environment.
DATABASE_READ_ONLY=False

# Fail fast if `manage.py migrate` is run. When left blank, this is automatically
# False in read-only mode and True otherwise. Set False to protect a remote
# write-enabled account as well.
DATABASE_ALLOW_MIGRATIONS=

# Used by Docker Compose only. Set False when connecting its app container to a
# remote database so startup cannot attempt to apply migrations.
RUN_MIGRATIONS=True
